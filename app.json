{
 "expo": {
  "name": "GlowFit",
  "slug": "glowfit",
  "version": "1.0.0",
  "orientation": "portrait",
  "userInterfaceStyle": "dark",
  "newArchEnabled": false,
  "ios": {
   "bundleIdentifier": "com.glowfit.app",
   "supportsTablet": false
  },
  "plugins": [
   [
    "expo-sensors",
    {
     "motionPermission": "GlowFit zählt deine Schritte."
    }
   ],
   [
    "expo-camera",
    {
     "cameraPermission": "GlowFit scannt dein Essen mit der Kamera."
    }
   ]
  ],
  "icon": "./assets/icon.png"
 }
}